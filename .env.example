# Copy to .env and fill in. Used by docker-compose (backend service).
# MONGO_URI, PORT, Inngest and Kafka (KAFKA_BROKERS) settings are set in docker-compose.yml.

JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini (AI triage)
GEMINI_API_KEY=

# Gmail SMTP for notifications (use a Gmail App Password, not your login password)
GMAIL_USER=
GMAIL_PASS=

APP_URL=http://localhost:8080
