# Remote state in S3 with DynamoDB locking (copy to backend.tf).
# Create the bucket and table once, before `terraform init`.
terraform {
  backend "s3" {
    bucket         = "smartticket-terraform-state-123456789012"
    key            = "eks/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "smartticket-terraform-locks"
    encrypt        = true
  }
}
