# Copy to terraform.tfvars (gitignored) and adjust.
region             = "ap-south-1"
cluster_name       = "smartticket"
kubernetes_version = "1.33"

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND" # "SPOT" for a cheaper dev cluster
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4

# IAM role/user that Jenkins uses (admin in the smartticket namespace only)
# ci_principal_arn = "arn:aws:iam::123456789012:role/jenkins-smartticket"

# Dev only: let `terraform destroy` remove ECR repos that still hold images
ecr_force_delete = true
