# Copy to ci/webhook/.env (gitignored).

# Create a channel at https://smee.io -> "Start a new channel", paste its URL here.
# Use the SAME URL as the "Payload URL" of the GitHub webhook.
SMEE_URL=https://smee.io/your-private-channel-id

# Where the relay forwards events. Default: Jenkins published on the host at port 8080.
JENKINS_WEBHOOK_URL=http://host.docker.internal:8080/github-webhook/
